dns:
  bootstrap:
  - system
  - 223.5.5.5
  - 223.6.6.6
  - 119.28.28.28
  - 119.29.29.29
  - 180.76.76.76
  - 2400:da00::6666
  upstreams:
    DIRECT-DNS:
    - 180.76.76.76
    - 2400:da00::6666
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    PROXY-DNS:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://cloudflare-dns.com/dns-query
    REMOTE-DNS:
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query
  forward:
  - domain_suffix:
      match: me.uk
      value: DIRECT-DNS
  - domain_suffix:
      match: xiaoyan.io
      value: DIRECT-DNS
  - domain_suffix:
      match: linuxlh.xin
      value: DIRECT-DNS
  - proxy_rule_set:
      match: https://yfamilys.com/rule/DouYin.list
      value: DIRECT-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/TikTok.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://raw.githubusercontent.com/IBL3ND/rule/refs/heads/main/Gemini.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/ai-global.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/Gemini.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/OpenAI.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/rule/openai.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://magicrule.pages.dev/data/_shared/artifacts/OpenAI_rules_f362ba1006ae0e0c.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/Binance.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/Twitter.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/Telegram.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/YouTube.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/Instagram.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/Cloudflare.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://raw.githubusercontent.com/GMOogway/shadowrocket-rules/master/sr_proxy_list.module
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://yfamilys.com/rule/ProxyMedia.list
      value: REMOTE-DNS
      disabled: false
  - proxy_rule_set:
      match: https://raw.githubusercontent.com/Rabbit-Spec/Surge/refs/heads/Master/Rules/China.list
      value: DIRECT-DNS
      disabled: false
  - proxy_rule_set:
      match: https://raw.githubusercontent.com/Loyalsoldier/surge-rules/release/ruleset/direct.txt
      value: DIRECT-DNS
      disabled: false
  - proxy_rule_set:
      match: https://raw.githubusercontent.com/GMOogway/shadowrocket-rules/master/sr_direct_list.module
      value: DIRECT-DNS
      disabled: false
  - domain_wildcard:
      match: '*'
      value: REMOTE-DNS
      disabled: false
  proxy_nameservers:
  - PROXY-DNS
